/**
 * Calendrier cultural par zone agro-climatique.
 * Sud   : régime bimodal (2 saisons des pluies : avril-juillet et sept-nov)
 * Centre: saison longue et progressive (avril à octobre)
 * Nord  : saison unique et courte (mai/juin à octobre)
 */
const CALENDRIERS_PAR_ZONE = {
  sud: {
    "Janvier": ["Maraîchage", "Manioc (récolte)"],
    "Février": ["Maraîchage", "Préparation des sols"],
    "Mars": ["Maïs (semis)", "Manioc (plantation)"],
    "Avril": ["Maïs (semis)", "Arachide (semis)", "Manioc"],
    "Mai": ["Maïs (entretien)", "Maraîchage"],
    "Juin": ["Maïs (récolte)", "Riz (semis)"],
    "Juillet": ["Manioc", "Maraîchage", "Palmier à huile (récolte)"],
    "Août": ["Maïs (2e semis)", "Riz (entretien)"],
    "Septembre": ["Maïs (2e saison)", "Riz (entretien)"],
    "Octobre": ["Riz (récolte)", "Maïs (récolte)"],
    "Novembre": ["Manioc (récolte)", "Palmier à huile (récolte)", "Cocotier (récolte)"],
    "Décembre": ["Maraîchage", "Manioc"]
  },
  centre: {
