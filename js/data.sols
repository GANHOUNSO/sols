    "Février": ["Anacarde (floraison)", "Préparation des sols"],
    "Mars": ["Igname (plantation)"],
    "Avril": ["Maïs (semis)", "Igname"],
    "Mai": ["Maïs (entretien)", "Igname (entretien)"],
    "Juin": ["Maïs (récolte)", "Coton (semis)"],
    "Juillet": ["Coton (entretien)", "Igname"],
    "Août": ["Igname (récolte précoce)", "Anacarde (récolte)"],
    "Septembre": ["Igname (récolte)", "Maïs (2e semis)"],
    "Octobre": ["Coton (récolte)", "Maïs (récolte)"],
    "Novembre": ["Igname (récolte tardive)"],
    "Décembre": ["Anacarde (floraison)"]
  },
  nord: {
    "Janvier": ["Coton (récolte tardive)"],
    "Février": ["Préparation des sols"],
    "Mars": ["Préparation des sols"],
    "Avril": ["Préparation des sols"],
